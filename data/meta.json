{
  "feed": "meta",
  "description": "Manifest of the India Threat Tracker data files. Each resource has its own structure and, where it is JSON, its own schema; there is no shared envelope.",
  "project": "India Threat Tracker",
  "maintainer": "Sohan Kanna (@sohankanna)",
  "site": "https://www.sohankanna.com/tracker",
  "repository": "https://github.com/sohankanna/india-threat-tracker",
  "data_guide": "https://github.com/sohankanna/india-threat-tracker/blob/main/DATA-GUIDE.md",
  "methodology": "https://github.com/sohankanna/india-threat-tracker/blob/main/METHODOLOGY.md",
  "license": "MIT (code) / CC-BY-4.0 (data)",
  "updated_at": "2026-10-20",
  "resources": {
    "watchlist": {
      "file": "data/watchlist.json",
      "kind": "feed",
      "format": "json",
      "schema": "schema/watchlist.schema.json",
      "updated_by": "automation",
      "cadence": "twice-daily",
      "description": "KEV entries that are India-relevant (high or medium) and added in the last 24 calendar months or ransomware-linked"
    },
    "exploited-cve": {
      "file": "data/exploited-cve.json",
      "kind": "feed",
      "format": "json",
      "schema": "schema/exploited-cve.schema.json",
      "updated_by": "automation",
      "cadence": "twice-daily",
      "description": "Every CISA KEV entry, enriched with FIRST EPSS and an India-relevance tier, with EPSS enrichment health"
    },
    "smishing-apk": {
      "file": "data/smishing-apk.json",
      "kind": "feed",
      "format": "json",
      "schema": "schema/smishing-apk.schema.json",
      "updated_by": "curated",
      "cadence": "as-observed",
      "description": "Fake-APK and smishing campaigns affecting Indian users"
    },
    "apt-campaigns": {
      "file": "data/apt-campaigns.json",
      "kind": "feed",
      "format": "json",
      "schema": "schema/apt-campaign.schema.json",
      "updated_by": "curated",
      "cadence": "as-observed",
      "description": "State-nexus actors targeting India, plus regional context"
    },
    "assessment": {
      "file": "data/assessment.json",
      "kind": "assessment",
      "format": "json",
      "schema": "schema/assessment.schema.json",
      "updated_by": "analyst",
      "cadence": "monthly",
      "description": "Ranked analyst assessment of what matters this month, with evidence references to feed records and sources"
    },
    "relevance-overrides": {
      "file": "data/relevance-overrides.json",
      "kind": "editorial",
      "format": "json",
      "schema": "schema/relevance-overrides.schema.json",
      "updated_by": "analyst",
      "cadence": "on-review",
      "description": "Hand-reviewed India-relevance decisions; the pipeline reads them and never writes them"
    },
    "iocs-csv": {
      "file": "data/iocs.csv",
      "kind": "export",
      "format": "csv",
      "derived_from": "data/smishing-apk.json",
      "updated_by": "automation",
      "cadence": "twice-daily",
      "description": "Defanged campaign indicators with provenance per row; never contains infrastructure context"
    },
    "iocs-txt": {
      "file": "data/iocs.txt",
      "kind": "export",
      "format": "text",
      "derived_from": "data/smishing-apk.json",
      "updated_by": "automation",
      "cadence": "twice-daily",
      "description": "The same indicators, one per line, with a provenance header"
    },
    "meta": {
      "file": "data/meta.json",
      "kind": "manifest",
      "format": "json",
      "schema": "schema/meta.schema.json",
      "updated_by": "analyst",
      "cadence": "on-change",
      "description": "This manifest"
    }
  }
}
