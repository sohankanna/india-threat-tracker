{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lookalike domains",
  "description": "Registered lookalike domains of Indian banks, payment apps and government sites, from scripts/scan_lookalikes.py. Leads, not verdicts. Domains are defanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feed",
    "generated_at",
    "warning",
    "baseline_date",
    "scans",
    "candidates_checked",
    "summary",
    "count",
    "items"
  ],
  "properties": {
    "feed": {
      "const": "lookalike-domains"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "warning": {
      "type": "string",
      "minLength": 20
    },
    "baseline_date": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scans": {
      "type": "integer",
      "minimum": 0
    },
    "candidates_checked": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "required": [
        "registered",
        "new_last_30_days",
        "new_with_certificate_last_30_days",
        "by_brand_new_last_30_days"
      ],
      "properties": {
        "registered": {
          "type": "integer"
        },
        "new_last_30_days": {
          "type": "integer"
        },
        "new_with_certificate_last_30_days": {
          "type": "integer"
        },
        "by_brand_new_last_30_days": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "count": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "brand",
          "brand_name",
          "sector",
          "label",
          "fuzzer",
          "first_seen",
          "last_seen",
          "active",
          "baseline",
          "a",
          "ns",
          "mx",
          "first_cert"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\[\\.\\][a-z0-9-]+)+$",
            "description": "Defanged: dots written as [.]"
          },
          "brand": {
            "type": "string"
          },
          "brand_name": {
            "type": "string"
          },
          "sector": {
            "enum": [
              "banking",
              "payments",
              "government"
            ]
          },
          "label": {
            "type": "string"
          },
          "fuzzer": {
            "type": "string"
          },
          "first_seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "last_seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "active": {
            "type": "boolean"
          },
          "baseline": {
            "type": "boolean"
          },
          "a": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          },
          "ns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          },
          "mx": {
            "type": "boolean"
          },
          "first_cert": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
