{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "India-relevance editorial overrides",
  "type": "object",
  "required": ["feed", "overrides"],
  "properties": {
    "feed": { "const": "relevance-overrides" },
    "description": { "type": "string" },
    "overrides": {
      "type": "object",
      "propertyNames": { "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["tier", "reason", "reviewed"],
        "additionalProperties": false,
        "properties": {
          "tier": { "enum": ["high", "medium", "global"] },
          "reason": { "type": "string", "minLength": 10 },
          "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "watchlist": { "type": "boolean" }
        }
      }
    }
  }
}
