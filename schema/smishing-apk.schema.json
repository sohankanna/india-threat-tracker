{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "smishing-apk feed",
  "type": "object",
  "required": [
    "feed",
    "generated_at",
    "count",
    "items"
  ],
  "properties": {
    "feed": {
      "const": "smishing-apk"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "count": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "date_added",
          "india_relevance",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "first_seen": {
            "type": "string"
          },
          "date_added": {
            "type": "string"
          },
          "last_updated": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "historical",
              "law-enforcement"
            ]
          },
          "lure_themes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impersonates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "iocs": {
            "type": "object",
            "description": "Specific, campaign-associated indicators suitable for investigation. Defanged. Never shared/legitimate services.",
            "additionalProperties": false,
            "properties": {
              "domains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sha256": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "package_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "telegram_bots": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "india_relevance": {
            "enum": [
              "high",
              "medium",
              "global"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references_blog": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "last_verified": {
            "type": "string"
          },
          "infrastructure": {
            "type": "object",
            "description": "Context only, NOT indicators: legitimate platforms abused, hosting providers, C2 technology. Never use as blocklist entries.",
            "additionalProperties": false,
            "properties": {
              "abused_platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hosting_providers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "c2_technology": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "category": {
            "type": "string",
            "description": "Short threat category shown on the site, e.g. 'Android banking malware', 'Fraud network, police action', 'Reference: lure themes'"
          },
          "attribution": {
            "type": "string",
            "description": "Who the source attributes the activity to, as reported. Not the tracker's own assessment."
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attack": {
            "type": "array",
            "description": "MITRE ATT&CK techniques mapped by the tracker from behaviour described in the cited sources",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "key_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
