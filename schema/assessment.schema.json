{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "India Threat Assessment",
  "type": "object",
  "required": ["feed", "period", "updated", "analyst", "summary", "items"],
  "properties": {
    "feed": { "const": "india-threat-assessment" },
    "period": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "analyst": { "type": "string" },
    "summary": { "type": "string", "minLength": 20 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "title", "category", "severity", "why"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["payments-fraud", "exploited-vulns", "apt", "malware", "other"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium-high", "medium", "low"]
          },
          "why": { "type": "string", "minLength": 20 },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  }
}
